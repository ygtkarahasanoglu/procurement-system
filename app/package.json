{
  "name": "procurement-system",
  "version": "0.1.0",
  "description": "YGT Procurement System - MVP vertical slice (Request -> Quotes -> AI Recommendation -> Human Decision -> Frozen DecisionPackage -> Approval -> PurchaseOrder)",
  "private": true,
  "main": "index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev:api": "tsx src/api/server.ts",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "tsx src/seed/seed.ts",
    "provision:pilot-identity": "tsx src/scripts/provisionExternalIdentity.ts",
    "bootstrap:provisioning-capability": "tsx src/scripts/grantProvisioningCapability.ts",
    "smoke:extract": "tsx src/scripts/smokeExtract.ts",
    "test": "dotenv -e .env.test -- vitest run",
    "test:watch": "dotenv -e .env.test -- vitest",
    "test:e2e-ui": "playwright test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^26.6.4",
    "dotenv-cli": "^11.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@google/genai": "^2.28.0",
    "@prisma/client": "^6.9.0",
    "cookie": "^1.1.1",
    "cors": "^2.8.6",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "openid-client": "^6.8.8",
    "prisma": "^6.9.0"
  }
