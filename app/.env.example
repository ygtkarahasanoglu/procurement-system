# AUTHN-11: comma-separated exact trusted browser origin(s) allowed to make
# credentialed cross-origin requests (session cookie auth). This is the
# repository's existing local-dev pairing only (web/.env.example's
# VITE_API_BASE_URL=http://localhost:3000 implies the Vite default dev
# origin below) — never a production value. Unset/empty means no
# cross-origin browser request is allowed (fail closed, no wildcard).
# Production deployment must set its own real origin(s) at deploy time.
CORS_TRUSTED_ORIGINS="http://localhost:5173"
