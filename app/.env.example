DATABASE_URL="postgresql://ygt_dev:ygt_dev_password@localhost:5432/procurement_dev?schema=public"

# AUTHN: OIDC provider configuration required by loadOidcConfigFromEnv()
# (app/src/api/authRoutes.ts) for /auth/login and /auth/callback. Provider
# selection and real values are explicitly deferred — these are documented
# here as the required variable names/shape only, never a real secret or
# provider choice.
OIDC_ISSUER_URL=""
OIDC_CLIENT_ID=""
OIDC_CLIENT_SECRET=""
OIDC_REDIRECT_URI="http://localhost:3000/auth/callback"

# AUTHN-11: comma-separated exact trusted browser origin(s) allowed to make
# credentialed cross-origin requests (session cookie auth). This is the
# repository's existing local-dev pairing only (web/.env.example's
# VITE_API_BASE_URL=http://localhost:3000 implies the Vite default dev
# origin below) — never a production value. Unset/empty means no
# cross-origin browser request is allowed (fail closed, no wildcard).
# Production deployment must set its own real origin(s) at deploy time.
CORS_TRUSTED_ORIGINS="http://localhost:5173"

# AUTHN: absolute frontend URL a browser is sent to after a successful
# /auth/callback. This is the repository's existing local-dev pairing
# only (the Vite default dev origin, matching CORS_TRUSTED_ORIGINS above)
# — never a production value. Never derived from the request; missing or
# invalid fails closed (500), it never falls back to a relative path.
# Production deployment must set its own real frontend URL at deploy time.
POST_LOGIN_REDIRECT_URL="http://localhost:5173/"

# RFQ-PD15/RFQ-PD16 (docs/decisions/ratified.md): the single configured
# SendGrid Event Webhook verification public key (base64, obtained from
# the SendGrid dashboard), used to authenticate POST /webhooks/sendgrid/events.
# No automated rotation, no multi-key rollover — replacing this value is a
# manual, deliberate operator action. Never a real secret in this file;
# a real deployment sets its own value at deploy time.
SENDGRID_EVENT_WEBHOOK_VERIFICATION_KEY=""
