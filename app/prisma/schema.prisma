// YGT Procurement System — MVP vertical slice data model.
//
// Scope: only the entities needed for the single ratified-rule-complete
// scenario (Request -> Quotes -> AI Recommendation -> Human Decision ->
// Frozen DecisionPackage -> Approval -> PurchaseOrder). See
// app/README.md for the mapping from each model to the ratified decision
// it implements, and for what is explicitly NOT implemented in V1.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------
// Tenancy & actors
// ---------------------------------------------------------------------

model Tenant {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  users            User[]
  products         Product[]
  suppliers        Supplier[]
  requests         ProcurementRequest[]
  requestLines     RequestLine[]
  sourcingEvents   SourcingEvent[]
  rfqDispatches    RFQDispatch[]
  supplierQuotes   SupplierQuote[]
  quoteVersions    QuoteVersion[]
  recommendations  RecommendationRecord[]
  decisionPackages DecisionPackage[]
  approvals        Approval[]
  purchaseOrders   PurchaseOrder[]
  rfqCommunicationEvents RFQCommunicationEvent[]
  rfqProviderDeliveryEvents RFQProviderDeliveryEvent[]
  quoteDocuments QuoteDocument[]
  quoteExtractions QuoteExtraction[]
}

// Minimum actor representation. Role is a plain string for V1 — see
// README "Authorization" section for what this does and does not enforce.
model User {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  role      String // e.g. "procurement_user" | "approver" — see README
  createdAt DateTime @default(now())

  // AUTHN-5 (docs/decisions/ratified.md): application-level authority to
  // perform external-identity provisioning. Deliberately separate from
  // `role` above — additive, never implied by any procurement-domain
  // role, and never checked by assertActorAuthorized. Defaults to false
  // for every existing and newly-created User; nothing in this schema
  // change grants it to anyone. How the first such User per tenant is
  // granted this remains OPEN (docs/decisions/open.md) — this column
  // only makes the capability representable, it does not bootstrap it.
  canProvisionExternalIdentities Boolean @default(false)

  requestsCreated  ProcurementRequest[] @relation("RequestCreatedBy")
  decisionsFormed  DecisionPackage[]    @relation("DecisionCreatedBy")
  approvalsGranted Approval[]           @relation("ApprovalGrantedBy")

  // AUTHN-1..AUTHN-11, Step 2: persistence only — no runtime authentication
  // exists yet. See the "Human authentication" section below.
  externalIdentities ExternalIdentity[]
  sessions           Session[]

  @@index([tenantId])
}

// ---------------------------------------------------------------------
// Product / Supplier reference data
// ---------------------------------------------------------------------

// Minimum product reference for V1. The full Product Identity domain
// (PI-C1-PI-C11) is NOT implemented here — this is a flat reference,
// not a category-specific identity model. See README limitations.
model Product {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  sku       String
  createdAt DateTime @default(now())

  requestLines  RequestLine[]
  quoteVersions QuoteVersion[]

  @@index([tenantId])
}

model Supplier {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  // Communication address for a future RFQ email dispatch. Nullable, no
  // uniqueness, no identity/authentication/verification semantics — see
  // the RFQ assessment (docs/decisions remain unchanged by this batch):
  // SEC-010 supplier authentication stays OPEN and is not addressed here.
  email     String?
  createdAt DateTime @default(now())

  supplierQuotes SupplierQuote[]
  rfqDispatches  RFQDispatch[]
  quoteDocuments QuoteDocument[]

  @@index([tenantId])
}

// ---------------------------------------------------------------------
// Procurement Request / Request Line (RL-C1, RL-C2)
// ---------------------------------------------------------------------

model ProcurementRequest {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  createdById String
  createdBy   User     @relation("RequestCreatedBy", fields: [createdById], references: [id])
  status      String   @default("OPEN")
  createdAt   DateTime @default(now())

  lines RequestLine[]

  @@index([tenantId])
}

// RL-C1: a Request may contain one or more independent lines.
model RequestLine {
  id                String             @id @default(uuid())
  tenantId          String
  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  requestId         String
  request           ProcurementRequest @relation(fields: [requestId], references: [id])
  productId         String
  product           Product            @relation(fields: [productId], references: [id])
  requestedQuantity Decimal            @db.Decimal(18, 4)
  unit              String
  createdAt         DateTime           @default(now())

  sourcingEvents SourcingEvent[]

  @@index([tenantId])
  @@index([requestId])
}

// ---------------------------------------------------------------------
// Sourcing / Quotes (RL-C2, RL-C3, RL-C4, PI-C8)
// ---------------------------------------------------------------------

// RL-C3: one active SourcingEvent per Request Line is the ratified shape;
// V1 enforces this at the service layer (see sourcingService.ts), not
// via a DB constraint, since "active" requires a status check this
// schema alone cannot express declaratively without a partial index.
model SourcingEvent {
  id            String      @id @default(uuid())
  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id])
  requestLineId String
  requestLine   RequestLine @relation(fields: [requestLineId], references: [id])
  status        String      @default("OPEN") // OPEN | CLOSED
  createdAt     DateTime    @default(now())

  rfqDispatches    RFQDispatch[]
  supplierQuotes   SupplierQuote[]
  recommendations  RecommendationRecord[]
  decisionPackages DecisionPackage[]
  quoteDocuments   QuoteDocument[]

  @@index([tenantId])
  @@index([requestLineId])
}

// A single supplier-facing RFQ dispatch under a SourcingEvent — R1 ("RFQ
// is modeled as SourcingEvent + RFQDispatch x N", docs/decisions/
// ratified.md) and 02-domain-model.md §7.3. This is the implementation
// of an already-ratified concept, not a new domain decision.
//
// Schema-only in this batch: no service, token generation/validation,
// response endpoint, or email sending exist yet. responseTokenHash
// stores only a SHA-256 hash, mirroring Session's own discipline
// (app/src/api/session.ts) — the raw token itself will exist only
// outside persistence, in a future batch; this batch does not implement
// hashing or token generation. Supplier authentication (SEC-010), resend
// policy, and quote resubmission/versioning all remain OPEN
// (docs/decisions/open.md) and are not resolved by this schema — in
// particular, no uniqueness constraint here implies "one dispatch per
// supplier/SourcingEvent" or "no resend".
model RFQDispatch {
  id                String        @id @default(uuid())
  tenantId          String
  tenant            Tenant        @relation(fields: [tenantId], references: [id])
  sourcingEventId   String
  sourcingEvent     SourcingEvent @relation(fields: [sourcingEventId], references: [id])
  supplierId        String
  supplier          Supplier      @relation(fields: [supplierId], references: [id])
  status            String        @default("PENDING") // PENDING | SENT | SEND_FAILED | RESPONDED
  responseTokenHash String?       @unique
  tokenExpiresAt    DateTime?
  respondedAt       DateTime?
  createdAt         DateTime      @default(now())

  // RFQ-EP4 (docs/decisions/ratified.md): opaque provider correlation
  // identifier only (e.g. SendGrid's X-Message-ID) — not Core authority,
  // not a lifecycle state, not delivery confirmation, not an idempotency
  // key. Null whenever the provider did not return one (deterministic
  // failure, or a success response that omitted it).
  providerMessageId String?

  supplierQuotes SupplierQuote[]
  communicationEvents RFQCommunicationEvent[]
  providerDeliveryEvents RFQProviderDeliveryEvent[]
  quoteDocuments QuoteDocument[]

  @@index([tenantId])
  @@index([sourcingEventId])
  @@index([supplierId])
}

// RFQ-EH1–RFQ-EH10 (docs/decisions/ratified.md): a tenant-scoped,
// append-only historical record of the RFQ communication/supplier-
// response lifecycle. Explicitly NOT the authoritative current state
// (RFQDispatch remains that, unchanged), NOT Execution Authority, NOT
// Approval, NOT a universal cross-domain AuditLog, and NOT an
// evidence/quote/PDF ingestion repository (RFQ-EH1). Normal application
// flow never updates or deletes a row here (RFQ-EH6).
//
// eventType is a closed set: DISPATCH_CREATED | SEND_ATTEMPT_RESULT |
// SUPPLIER_RESPONSE_RECEIVED (RFQ-EH2) — no other value is ever written.
// outcome is a closed set, used only on SEND_ATTEMPT_RESULT: ACCEPTED |
// FAILED | UNKNOWN — the fixed historical representation of
// SendOutcome.kind's success/failure/unknown (RFQ-EH2's canonical
// vocabulary amendment), never a RFQDispatch.status value.
// actorSource is a closed set: INTERNAL_USER | SYSTEM | SUPPLIER |
// PROVIDER — a domain-specific classification for this event type
// only, never a universal Actor/Authority entity (RFQ-EH8); actorUserId
// is populated only when actorSource = INTERNAL_USER.
// providerMessageId is the same opaque correlation primitive as
// RFQDispatch.providerMessageId (RFQ-EP4/RFQ-EH5) — never delivery
// proof, never an idempotency key — and is only ever set alongside
// outcome = ACCEPTED.
// quoteVersionId references (never copies) the QuoteVersion a
// SUPPLIER_RESPONSE_RECEIVED event produced (RFQ-EH2 item 3/RFQ-EH4).
//
// Deliberately excluded from this model, under any circumstance
// (RFQ-EH4): the raw RFQ email body, the response token in any form,
// any API key/Authorization header/secret, the raw provider response
// body, another tenant's data, or the supplier's submitted commercial
// content (that remains QuoteVersion's own, immutable home).
//
// No uniqueness constraint on (rfqDispatchId, eventType): SEND_ATTEMPT_RESULT
// legitimately recurs per dispatch across retries (RFQ-RT1/RFQ-RT3) —
// a naive unique constraint there would be incorrect, not merely unnecessary.
model RFQCommunicationEvent {
  id                String      @id @default(uuid())
  tenantId          String
  tenant            Tenant      @relation(fields: [tenantId], references: [id])
  rfqDispatchId     String
  rfqDispatch       RFQDispatch @relation(fields: [rfqDispatchId], references: [id])
  eventType         String // DISPATCH_CREATED | SEND_ATTEMPT_RESULT | SUPPLIER_RESPONSE_RECEIVED
  occurredAt        DateTime    @default(now())
  actorSource       String // INTERNAL_USER | SYSTEM | SUPPLIER | PROVIDER
  actorUserId       String?
  outcome           String? // ACCEPTED | FAILED | UNKNOWN — SEND_ATTEMPT_RESULT only
  providerMessageId String?
  quoteVersionId    String?
  quoteVersion      QuoteVersion? @relation(fields: [quoteVersionId], references: [id])

  @@index([tenantId])
  @@index([rfqDispatchId])
}

// Provider Delivery & Outcome Confirmation Boundary (RFQ-PD1–RFQ-PD20,
// docs/decisions/ratified.md). A dedicated, narrowly-scoped persistence
// for asynchronous SendGrid Event Webhook facts — deliberately separate
// from RFQCommunicationEvent (RFQ-PD13): this records externally
// asserted, at-least-once, provider-identified delivery evidence, not
// an action this system itself took or solicited. NOT the authoritative
// RFQDispatch send lifecycle (RFQ-PD2), NOT supplier receipt/read/
// acceptance (RFQ-PD20), NOT a generic event-sourcing/audit store
// (RFQ-PD13's own explicit Non-Goal).
//
// tenantId/rfqDispatchId are both nullable: correlation only succeeds
// after authenticated-webhook + exact custom_args.rfq_dispatch_id
// lookup (RFQ-PD4); an event that cannot be safely correlated is
// persisted with correlationState = UNCORRELATED and both left null
// (RFQ-PD5) — never a heuristic fallback assignment. Because a row can
// legitimately carry no tenantId at all, this model is deliberately
// EXCLUDED from db/client.ts's TENANT_SCOPED_MODELS guard (mirroring
// the existing, documented Tenant/ExternalIdentity/Session exclusions)
// — writes go through the bare `prisma` client, and any future
// tenant-scoped read of CORRELATED rows must filter by `tenantId`
// explicitly in its own `where`, the same way every service already
// did before the R15 backstop existed.
//
// eventType is the ratified closed, provider-neutral vocabulary:
// PROCESSED | DEFERRED | DELIVERED | BOUNCE | DROPPED (RFQ-PD7).
// providerSubtype preserves provider-specific detail where ratified as
// meaningful — e.g. SendGrid's `type=blocked` on a bounce becomes
// eventType=BOUNCE, providerSubtype=BLOCKED, never a top-level BLOCKED
// event (RFQ-PD7). UNKNOWN is never persisted here (RFQ-PD8) — absence
// of a webhook is absence of evidence, not a row.
//
// providerMessageId (sg_message_id) is retained only as diagnostic
// metadata for manual investigation of an UNCORRELATED event (RFQ-PD5)
// — application code must never use it for automatic correlation.
//
// (provider, providerEventId) is database-unique for deduplication
// (RFQ-PD6). Postgres's default unique-index semantics treat every NULL
// providerEventId as distinct from every other NULL (NULLS DISTINCT,
// the Postgres default — not overridden here), matching the ratified
// "NULL means explicitly non-deduplicable" requirement exactly: many
// rows may share provider="SENDGRID" with providerEventId=null without
// ever violating this constraint.
model RFQProviderDeliveryEvent {
  id String @id @default(uuid())

  provider        String  // "SENDGRID" — only provider implemented (RFQ-PD12)
  providerEventId String? // sg_event_id; null = explicitly non-deduplicable (RFQ-PD6)

  correlationState String // CORRELATED | UNCORRELATED (RFQ-PD5)

  tenantId      String?
  tenant        Tenant?      @relation(fields: [tenantId], references: [id])
  rfqDispatchId String?
  rfqDispatch   RFQDispatch? @relation(fields: [rfqDispatchId], references: [id])

  eventType       String  // PROCESSED | DEFERRED | DELIVERED | BOUNCE | DROPPED (RFQ-PD7)
  providerSubtype String? // e.g. BLOCKED — bounce subtype only (RFQ-PD7)

  providerEventAt DateTime // provider-reported event timestamp (RFQ-PD14)
  receivedAt      DateTime @default(now()) // system ingestion timestamp (RFQ-PD14)

  // Diagnostic-only correlation aid for UNCORRELATED investigation
  // (RFQ-PD5) — must never be read by any automatic correlation code path.
  providerMessageId String?

  @@unique([provider, providerEventId])
  @@index([tenantId])
  @@index([rfqDispatchId])
  @@index([correlationState])
}

// A quote "header" from one supplier for one SourcingEvent. The
// commercial content itself lives on QuoteVersion (immutable), per
// 03-data-model.md ("each quote_version is immutable once created").
model SupplierQuote {
  id              String        @id @default(uuid())
  tenantId        String
  tenant          Tenant        @relation(fields: [tenantId], references: [id])
  sourcingEventId String
  sourcingEvent   SourcingEvent @relation(fields: [sourcingEventId], references: [id])
  supplierId      String
  supplier        Supplier      @relation(fields: [supplierId], references: [id])
  // Nullable: traces a quote back to the RFQDispatch that solicited it,
  // once that path exists (future batch). The existing manually-entered
  // quote flow (quoteService.submitQuote) remains schema-compatible and
  // unchanged — it simply leaves this null, exactly as it does today.
  rfqDispatchId   String?
  rfqDispatch     RFQDispatch?  @relation(fields: [rfqDispatchId], references: [id])
  createdAt       DateTime      @default(now())

  versions QuoteVersion[]

  @@index([tenantId])
  @@index([sourcingEventId])
  @@index([rfqDispatchId])
}

// Immutable once created (03-data-model.md). V1 only ever creates
// version 1 per SupplierQuote — no re-quoting/versioning workflow is
// implemented (that is future scope: QuoteVersion substitution, OPEN).
model QuoteVersion {
  id              String        @id @default(uuid())
  tenantId        String
  tenant          Tenant        @relation(fields: [tenantId], references: [id])
  supplierQuoteId String
  supplierQuote   SupplierQuote @relation(fields: [supplierQuoteId], references: [id])
  versionNumber   Int           @default(1)
  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  quotedQuantity  Decimal       @db.Decimal(18, 4)
  unit            String
  unitPrice       Decimal       @db.Decimal(18, 4)
  currency        String
  createdAt       DateTime      @default(now())

  // AI-1 (docs/decisions/ratified.md): optional fields captured from a
  // quote document (AI extraction, human-confirmed) or entered manually.
  // Displayed only — not read by recommendationService.ts in V1.
  leadTimeDays    Int?
  paymentTermDays Int?
  validUntil      DateTime?
  incoterm        String?

  recommendations  RecommendationRecord[]
  decisionPackages DecisionPackage[]
  communicationEvents RFQCommunicationEvent[]
  quoteExtractions QuoteExtraction[]

  @@unique([supplierQuoteId, versionNumber])
  @@index([tenantId])
}

// AI-1 (docs/decisions/ratified.md): CapturedEvidence — the original
// quote document, stored unchanged. Two entry paths: a procurement user
// upload (uploadedVia USER, uploadedByUserId set) or a supplier upload
// through its RFQ response link (uploadedVia SUPPLIER_LINK,
// rfqDispatchId set, uploadedByUserId null — no Principal exists on
// that unauthenticated path). content stores the raw bytes; sha256 is
// computed at upload time for integrity/dedup-evidence purposes only
// (no dedup behavior is implemented on it in V1).
model QuoteDocument {
  id              String         @id @default(uuid())
  tenantId        String
  tenant          Tenant         @relation(fields: [tenantId], references: [id])
  sourcingEventId String
  sourcingEvent   SourcingEvent  @relation(fields: [sourcingEventId], references: [id])
  supplierId      String
  supplier        Supplier       @relation(fields: [supplierId], references: [id])
  rfqDispatchId   String?
  rfqDispatch     RFQDispatch?   @relation(fields: [rfqDispatchId], references: [id])
  fileName        String
  mimeType        String
  sizeBytes       Int
  sha256          String
  content         Bytes
  uploadedVia     String // "USER" | "SUPPLIER_LINK"
  uploadedByUserId String?
  createdAt       DateTime       @default(now())

  extractions QuoteExtraction[]

  @@index([tenantId])
  @@index([sourcingEventId])
  @@index([supplierId])
  @@index([rfqDispatchId])
}

// AI-1 (docs/decisions/ratified.md): the StructuredClaim produced by AI
// extraction from one QuoteDocument, plus its human Validation outcome.
// `extracted` holds the validated candidate-lines JSON (never persisted
// unvalidated, per R12 — "confidence never substitutes for evidence").
// quoteVersionId is set only on CONFIRMED, referencing (never copying)
// the resulting QuoteVersion's own immutable content.
model QuoteExtraction {
  id              String        @id @default(uuid())
  tenantId        String
  tenant          Tenant        @relation(fields: [tenantId], references: [id])
  quoteDocumentId String
  quoteDocument   QuoteDocument @relation(fields: [quoteDocumentId], references: [id])
  provider        String
  model           String
  status          String        // PENDING_REVIEW | CONFIRMED | REJECTED | FAILED
  extracted       Json?
  errorMessage    String?
  reviewedByUserId String?
  reviewedAt      DateTime?
  quoteVersionId  String?
  quoteVersion    QuoteVersion? @relation(fields: [quoteVersionId], references: [id])
  createdAt       DateTime      @default(now())

  @@index([tenantId])
  @@index([quoteDocumentId])
}

// ---------------------------------------------------------------------
// AI Recommendation (CR-C: non-binding, NOT the approved decision)
// ---------------------------------------------------------------------

// Explicitly non-authoritative. Never read by approvalService or
// purchaseOrderService. See recommendationService.ts for the
// deterministic/test provider that produces these records.
model RecommendationRecord {
  id                          String        @id @default(uuid())
  tenantId                    String
  tenant                      Tenant        @relation(fields: [tenantId], references: [id])
  sourcingEventId             String
  sourcingEvent               SourcingEvent @relation(fields: [sourcingEventId], references: [id])
  recommendedQuoteVersionId   String
  recommendedQuoteVersion     QuoteVersion  @relation(fields: [recommendedQuoteVersionId], references: [id])
  recommendedQuantity         Decimal       @db.Decimal(18, 4)
  providerName                String // e.g. "deterministic-test-provider-v1"
  isDeterministicTestProvider Boolean       @default(true)
  rationale                   String
  createdAt                   DateTime      @default(now())

  // FX-1 (docs/decisions/ratified.md): populated only when this
  // recommendation's candidate quotes spanned more than one currency and
  // TRY conversion was actually performed — null for every same-currency
  // recommendation (no FX call is ever made in that case). fxRatesUsed
  // is a plain { [currencyCode]: ratePerOneUnit } map for exactly the
  // currencies present among that comparison's candidates, so a past
  // recommendation's conversion can be reproduced later without
  // depending on TCMB still publishing the same historical bulletin.
  fxSource       String?
  fxBulletinDate String?
  fxRateType     String? // "SELLING" | "BUYING"
  fxRatesUsed    Json?

  @@index([tenantId])
  @@index([sourcingEventId])
}

// ---------------------------------------------------------------------
// Decision Formation / Freeze (CR-C, QS-C1, QS-C2)
// ---------------------------------------------------------------------

// status DRAFT -> FROZEN is a one-way transition (decisionService.ts).
// Once FROZEN, no service function mutates the commercial fields below —
// that immutability is enforced structurally (no update path exists),
// not merely by a status check at every call site.
model DecisionPackage {
  id                   String        @id @default(uuid())
  tenantId             String
  tenant               Tenant        @relation(fields: [tenantId], references: [id])
  sourcingEventId      String
  sourcingEvent        SourcingEvent @relation(fields: [sourcingEventId], references: [id])
  sourceQuoteVersionId String
  sourceQuoteVersion   QuoteVersion  @relation(fields: [sourceQuoteVersionId], references: [id])
  supplierId           String
  productId            String
  selectedQuantity     Decimal       @db.Decimal(18, 4) // QS-C1: the decision-maker's chosen quantity
  unit                 String
  unitPrice            Decimal       @db.Decimal(18, 4)
  currency             String
  status               String        @default("DRAFT") // DRAFT | FROZEN
  frozenAt             DateTime?
  createdById          String
  createdBy            User          @relation("DecisionCreatedBy", fields: [createdById], references: [id])
  createdAt            DateTime      @default(now())

  approvals Approval[]

  @@index([tenantId])
  @@index([sourcingEventId])
}

// ---------------------------------------------------------------------
// Approval (M2, APO-D1, APO-D2)
// ---------------------------------------------------------------------

// INSERT-only (M2): no update/delete is ever exposed by approvalService.
// V1 simplification (NOT a ratified cardinality decision): at most one
// Approval per DecisionPackage, enforced by the unique constraint below.
// Real PO/Approval/DecisionPackage cardinality is explicitly OPEN
// (APO-D1 non-decisions, Q3 non-decision #11) — this unique constraint
// is a V1 implementation choice, not a claim that cardinality is ratified.
model Approval {
  id                String          @id @default(uuid())
  tenantId          String
  tenant            Tenant          @relation(fields: [tenantId], references: [id])
  decisionPackageId String          @unique
  decisionPackage   DecisionPackage @relation(fields: [decisionPackageId], references: [id])
  status            String          @default("APPROVED") // V1 only ever creates APPROVED rows
  approvedById      String
  approvedBy        User            @relation("ApprovalGrantedBy", fields: [approvedById], references: [id])
  createdAt         DateTime        @default(now())

  purchaseOrder PurchaseOrder?

  @@index([tenantId])
}

// ---------------------------------------------------------------------
// PurchaseOrder (CR-A, CR-B.1, CR-B.2, CR-D1, CR-D2, Q3, APO-D1, APO-D2)
// ---------------------------------------------------------------------

// V1 simplification (NOT a ratified cardinality decision): at most one
// PurchaseOrder per Approval, enforced by the unique constraint below.
// Every commercial field here is copied verbatim from the Approval's
// DecisionPackage by purchaseOrderService.ts — there is no code path
// that accepts these fields as caller-supplied input.
model PurchaseOrder {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  approvalId String   @unique
  approval   Approval @relation(fields: [approvalId], references: [id])
  supplierId String
  productId  String
  quantity   Decimal  @db.Decimal(18, 4)
  unit       String
  unitPrice  Decimal  @db.Decimal(18, 4)
  currency   String
  createdAt  DateTime @default(now())

  @@index([tenantId])
}

// ---------------------------------------------------------------------
// Human authentication (docs/decisions/ratified.md, AUTHN-1..AUTHN-11,
// Step 2 — persistence only). No runtime authentication exists yet: no
// route reads or writes these tables, and the production composition
// root is unchanged (still fail-closed). See oidc.ts (Step 1) for the
// generic OIDC verification module these tables will eventually support.
// ---------------------------------------------------------------------

// (issuer, subject) -> User.id, per AUTHN-2 — the external identity key
// is this pair, never email. Deliberately carries no tenantId: tenant
// ownership is obtained through the mapped User, consistent with the
// existing single-tenant User.tenantId model (no R5 membership work).
model ExternalIdentity {
  id        String   @id @default(uuid())
  issuer    String
  subject   String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([issuer, subject])
  @@index([userId])
}

// Server-side session (AUTHN-4). Only a SHA-256 hash of the session token
// is ever persisted here — the raw token exists solely in the browser's
// cookie and is never written to this table. tokenHash is the primary
// key: a session is always looked up by exactly this one value, so no
// separate id column exists.
model Session {
  tokenHash  String   @id
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())

  @@index([userId])
}
